# Database (Neon / Supabase / local Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/buddy_script?schema=public"

# JWT (min 32 characters)
JWT_SECRET="replace-with-a-random-32-character-minimum-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Upload limits
MAX_UPLOAD_SIZE="5242880"

# Rate limiting
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"

# CORS (comma-separated list of allowed origins for /api/*; leave blank for same-origin only)
ALLOWED_ORIGINS=""

# Public site URL (used for absolute links, e.g. in email templates if added later)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Demo Mode — fictional bot accounts generate background activity (posts,
# likes, comments, friend requests, messages) and a "Continue with Demo
# Account" login button appears. See README "Demo Mode" section.
DEMO_MODE="true"

# Google OAuth — optional. Leave both blank to keep the real "Continue with
# Google" button hidden (the demo login button is shown instead). Get these
# from https://console.cloud.google.com/apis/credentials (Web application
# OAuth client; add "<your-origin>/api/auth/google/callback" as an
# authorized redirect URI).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
