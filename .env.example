# Database (Neon / Supabase / local Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/buddy_script?schema=public"

# JWT (min 32 characters)
JWT_SECRET="replace-with-a-random-32-character-minimum-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Upload limits
MAX_UPLOAD_SIZE="5242880"

# Rate limiting
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"

# CORS (comma-separated list of allowed origins for /api/*; leave blank for same-origin only)
ALLOWED_ORIGINS=""

# Public site URL (used for absolute links, e.g. in email templates if added later)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
