generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FOLLOW
  LIKE
  COMMENT
  REPLY
  MESSAGE
  EVENT
  SHARE
  MENTION
  GROUP_POST
  GROUP_JOIN
  LESSON_RECOMMENDED
  LEADERBOARD
}

enum UserSource {
  USER
  GOOGLE
  DEMO_BOT
}

enum ContactPermission {
  EVERYONE
  FRIENDS
  NOBODY
}

enum ThemePreference {
  LIGHT
  DARK
}

enum FeedDensity {
  COMFORTABLE
  COMPACT
}

enum GroupRole {
  OWNER
  MEMBER
}

enum LearningCategory {
  WEB_DEVELOPMENT
  UI_UX_DESIGN
  GAME_DEVELOPMENT
  CAREER_SKILLS
}

enum GameType {
  TIC_TAC_TOE
  MEMORY_MATCH
  REACTION_TIMER
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  firstName     String
  lastName      String
  password      String
  avatarUrl     String?
  coverImageUrl String?
  bio           String?
  source        UserSource @default(USER)
  isDemoAccount Boolean    @default(false)
  location      String?
  interests     String[]   @default([])

  profileVisibility       PostVisibility    @default(PUBLIC)
  defaultPostVisibility   PostVisibility    @default(PUBLIC)
  whoCanSendFriendRequest ContactPermission @default(EVERYONE)
  whoCanMessage           ContactPermission @default(EVERYONE)
  notifyOnMessage         Boolean           @default(true)
  notifyOnFriendRequest   Boolean           @default(true)
  notifyOnComment         Boolean           @default(true)
  notifyOnGroupActivity   Boolean           @default(true)
  notifyOnEvent           Boolean           @default(true)
  themePreference         ThemePreference   @default(LIGHT)
  feedDensity             FeedDensity       @default(COMFORTABLE)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  posts        Post[]
  comments     Comment[]
  replies      Reply[]
  likes        Like[]
  commentLikes CommentLike[]
  replyLikes   ReplyLike[]

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendships            Friendship[]    @relation("UserFriendships")
  friendOfFriendships    Friendship[]    @relation("FriendOfFriendship")

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  eventsCreated     Event[]
  eventAttendances  EventAttendee[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  notifications          Notification[] @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("ActorNotifications")

  blocksMade     Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")

  dismissedSuggestions DismissedSuggestion[] @relation("DismissedByUser")
  dismissedByOthers    DismissedSuggestion[] @relation("DismissedTarget")

  savedPosts   SavedPost[]   @relation("SavedPosts")
  savedCourses SavedCourse[] @relation("SavedCourses")
  lessonProgress UserLessonProgress[] @relation("LessonProgress")
  gameScores   GameScore[]   @relation("GameScores")

  groupsCreated    Group[]       @relation("GroupsCreated")
  groupMemberships GroupMember[] @relation("GroupMemberships")
  groupPosts       GroupPost[]   @relation("GroupPostsAuthored")

  @@index([email])
  @@index([isDemoAccount])
}

model Post {
  id            String         @id @default(cuid())
  content       String
  imageUrl      String?
  imageBlurHash String?
  visibility    PostVisibility @default(PUBLIC)
  userId        String
  sharedFromId  String?
  demoEventKey  String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  sharedFrom Post?     @relation("PostShares", fields: [sharedFromId], references: [id], onDelete: SetNull)
  shares     Post[]    @relation("PostShares")
  saves      SavedPost[] @relation("PostSaves")

  @@index([userId])
  @@index([createdAt])
  @@index([visibility, createdAt])
  @@index([sharedFromId])
}

model Comment {
  id           String   @id @default(cuid())
  content      String
  userId       String
  postId       String
  demoEventKey String?  @unique
  createdAt    DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies Reply[]
  likes   CommentLike[]

  @@index([postId])
  @@index([userId])
}

model Reply {
  id        String   @id @default(cuid())
  content   String
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likes   ReplyLike[]

  @@index([commentId])
  @@index([userId])
}

model Like {
  id           String   @id @default(cuid())
  userId       String
  postId       String
  demoEventKey String?  @unique
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model ReplyLike {
  id        String   @id @default(cuid())
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
  @@index([replyId])
}

model FriendRequest {
  id           String              @id @default(cuid())
  senderId     String
  receiverId   String
  status       FriendRequestStatus @default(PENDING)
  demoEventKey String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOfFriendship", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  location      String?
  eventDate     DateTime
  createdById   String
  createdAt     DateTime @default(now())

  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendees EventAttendee[]

  @@index([createdById])
  @@index([eventDate])
}

model EventAttendee {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  demoEventKey String?  @unique
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Message {
  id           String    @id @default(cuid())
  senderId     String
  receiverId   String
  content      String
  readAt       DateTime?
  isAutoReply  Boolean   @default(false)
  demoEventKey String?   @unique
  createdAt    DateTime  @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([receiverId, readAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    String?
  commentId String?
  replyId   String?
  eventId   String?
  groupId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model DismissedSuggestion {
  id            String   @id @default(cuid())
  userId        String
  dismissedId   String
  createdAt     DateTime @default(now())

  user       User @relation("DismissedByUser", fields: [userId], references: [id], onDelete: Cascade)
  dismissed  User @relation("DismissedTarget", fields: [dismissedId], references: [id], onDelete: Cascade)

  @@unique([userId, dismissedId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation("SavedPosts", fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation("PostSaves", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model Group {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  coverImageUrl String?
  demoKey       String?  @unique
  createdById   String?
  createdAt     DateTime @default(now())

  createdBy User?         @relation("GroupsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  members   GroupMember[]
  posts     GroupPost[]

  @@index([createdAt])
}

model GroupMember {
  id           String    @id @default(cuid())
  groupId      String
  userId       String
  role         GroupRole @default(MEMBER)
  demoEventKey String?   @unique
  joinedAt     DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupPost {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  content      String
  demoEventKey String?  @unique
  createdAt    DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupPostsAuthored", fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model LearningCourse {
  id           String           @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String?
  category     LearningCategory
  demoKey      String?          @unique
  createdAt    DateTime         @default(now())

  lessons LearningLesson[]
  savedBy SavedCourse[]

  @@index([category])
}

model LearningLesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String
  order       Int
  durationMin Int      @default(10)
  createdAt   DateTime @default(now())

  course   LearningCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress UserLessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
}

model UserLessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completedAt  DateTime?
  demoEventKey String?   @unique
  createdAt    DateTime  @default(now())

  user   User           @relation("LessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  lesson LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model SavedCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User           @relation("SavedCourses", fields: [userId], references: [id], onDelete: Cascade)
  course LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model GameScore {
  id           String   @id @default(cuid())
  userId       String
  gameType     GameType
  score        Int
  demoEventKey String?  @unique
  createdAt    DateTime @default(now())

  user User @relation("GameScores", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType])
  @@index([gameType, score])
}
